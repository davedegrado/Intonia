<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo dei widget: notte indaco di Intonia con bordo viola. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#241A63"
                android:endColor="#161443"
                android:startColor="#1E1B57" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E63B3592" />
        </shape>
    </item>
</layer-list>
