<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo del widget: viola acceso che sfuma nel navy dell'app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#2A1B6E"
                android:endColor="#0B0730"
                android:startColor="#6D28D9" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66C084FC" />
        </shape>
    </item>
</layer-list>
