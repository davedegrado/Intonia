<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema della finestra durante l'avvio: mostra la splash finché Flutter
         non disegna il primo frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema dietro l'interfaccia Flutter: stesso colore della splash, così non
         compare un lampo bianco tra splash e primo frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
